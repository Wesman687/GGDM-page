## 🔄 File Patterns (FOLLOW EXACTLY)

### Backend Endpoint Pattern
```python
from fastapi import APIRouter, Depends, Query, HTTPException
from sqlalchemy.orm import Session
from ..database import get_db
from ..models import ScriptCreate, Script

router = APIRouter(prefix="/api/scripts", tags=["scripts"])

@router.post("/", response_model=Script)
async def create_script(
    script_data: ScriptCreate,
    user_id: str = Query(..., description="Discord ID"),
    db: Session = Depends(get_db)
):
    """
    Create a new script.
    
    Requires Discord authentication. Scripts start as unapproved.
    Jasown scripts are auto-approved with weighted ratings.
    """
    # Validation
    if len(script_data.tags) > 3:
        raise HTTPException(400, detail="Maximum 3 tags allowed")
    
    # Business logic
    # ...
    
    return script
```

### Frontend API Call Pattern
```typescript
import axios from 'axios';
import { useSession } from 'next-auth/react';

interface CreateScriptParams {
  title: string;
  code: string;
  tags: string[];
}

/**
 * Creates a new script via API.
 * 
 * @param scriptData - Script data to create
 * @returns Created script with ID
 * @throws Error if creation fails or user unauthorized
 */
async function createScript(scriptData: CreateScriptParams) {
  const { data: session } = useSession();
  
  try {
    const response = await axios.post('/api/scripts', scriptData, {
      params: {
        user_id: session.user.discordId
      }
    });
    return response.data;
  } catch (error) {
    if (error.response?.status === 401) {
      throw new Error('Authentication expired');
    } else if (error.response?.status === 403) {
      throw new Error('Not authorized');
    }
    throw new Error('Failed to create script');
  }
}
```

### React Component Pattern
```typescript
import { useState } from 'react';

interface ScriptCardProps {
  script: Script;
  onRate: (rating: number) => void;
}

/**
 * Displays a script card with rating functionality.
