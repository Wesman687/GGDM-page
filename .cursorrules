 * Shows title, author, tags, and interactive rating stars.
 * Requires user to be authenticated to rate.
 */
export default function ScriptCard({ script, onRate }: ScriptCardProps) {
  const [isLoading, setIsLoading] = useState(false);
  
  // Component implementation
  
  return (
    // JSX
  );
}
```

## 🔐 Security Rules (ENFORCE)

### Authentication
- **Server-side verification ALWAYS** - Never trust client
- **Admin checks on backend** - Use `is_super_admin(user_id)` helper
- **Discord ID required** - All user operations need `user_id`
- **Session validation** - Check session exists and is valid

### Input Validation
- **Pydantic models REQUIRED** - All request bodies
- **Query parameter validation** - Use FastAPI Query with validation
- **Sanitize user content** - Before displaying in UI
- **SQL injection prevention** - SQLAlchemy ONLY, no raw SQL

### Secrets Management
- **NEVER commit** `.env` files
- **Use environment variables** - All secrets in `.env`
- **Check `.gitignore`** - Ensure secrets excluded

## 🎯 Breaking Changes & Backward Compatibility

### Before Making Breaking Changes
1. ❓ **ASK**: "Does this break existing functionality?"
2. ❓ **ASK**: "Do we need a migration script?"
3. ❓ **ASK**: "Will this affect existing user data?"
4. ✅ **If YES to any**: Request explicit approval before proceeding

### Database Changes
- **Create migration script** for all schema changes
- **Name pattern**: `migrate_{description}.py`
- **Test migration** on copy of production data
- **Document in** `/AI/status.md`

### API Changes
- **Version new endpoints** - Use `/api/v2/...` if breaking
- **Deprecate gradually** - Keep old endpoint with warning
- **Document changes** - Update API docs

## 📦 File Organization (STRICT)

### Frontend Structure
```
frontend/
├── components/          # Reusable UI components
│   ├── {Feature}Card.tsx
│   └── {Feature}Modal.tsx
├── hooks/              # Custom React hooks
│   └── use{Feature}.ts
├── lib/                # Utilities and helpers
│   ├── api.ts          # API client
│   └── auth.tsx        # Auth context
├── pages/              # Next.js routes
│   ├── api/            # API routes (NextAuth, etc.)
│   └── {route}.tsx
└── types/              # TypeScript types/interfaces
    └── {domain}.ts
```

### Backend Structure
```
backend/
├── routes/             # API route handlers
│   ├── scripts.py
│   └── admin.py
├── models.py           # Pydantic models
├── database.py         # SQLAlchemy models
├── ai_*.py            # AI modules (consolidated)
├── services/          # Business logic services
├── utils/             # Helper utilities
└── migrate_*.py       # Database migrations
```

## 🚨 Error Handling Patterns (REQUIRED)

### Backend Errors
```python
# Validation error
if not data:
    raise HTTPException(status_code=400, detail="Data required")

# Not found
if not resource:
    raise HTTPException(status_code=404, detail="Resource not found")

# Unauthorized
if not is_admin:
    raise HTTPException(status_code=403, detail="Admin access required")

# Server error
try:
    # operation
except Exception as e:
    logger.error(f"Error: {e}")
    raise HTTPException(status_code=500, detail="Internal server error")
```

### Frontend Errors
```typescript
// Use Modal components for errors
const [error, setError] = useState<string | null>(null);

try {
  await apiCall();
} catch (error) {
  if (error.response?.status === 401) {
    setError('Session expired. Please sign in again.');
    signOut();
  } else if (error.response?.status === 403) {
    setError('You do not have permission for this action.');
  } else {
    setError('An error occurred. Please try again.');
  }
}

// Display in Modal
{error && <ErrorModal message={error} onClose={() => setError(null)} />}
```

## 📊 Data Patterns (CRITICAL)

### Script Creation
```python
# User uploads (default unapproved)
script = ScriptsCacheDB(
    id=str(uuid.uuid4()),
    title=script_data.title,
    author=script_data.author,
    code_preview=script_data.code[:500],  # First 500 chars
    full_code=script_data.code,
    is_approved=False,  # ALWAYS start unapproved
    created_by=user_id,  # Discord ID
)

# Jasown special handling
if script.author.lower() in ["jasown", "jasown scripts"]:
    script.is_approved = True
    script.rating_average = 5.0
    script.rating_count = 5
```

### Rating Calculation
```python
def calculate_weighted_rating(ratings):
    """
    Calculate weighted average rating.
    
    User ratings: weight = 1
    Jasown ratings: weight = 5
    """
    total_weighted = sum(r.rating * r.weight for r in ratings)
    total_weight = sum(r.weight for r in ratings)
    
    if total_weight == 0:
        return 0, 0
    
    return total_weighted / total_weight, total_weight
```

### AI Confidence Decision
```python
def determine_action(confidence):
    """Determine action based on AI confidence score."""
    if confidence >= 0.8:
        return "proceed"
    elif confidence >= 0.5:
        return "ask_user"
    elif confidence >= 0.3:
        return "admin_review"
    else:
        return "urgent_admin_review"
```

