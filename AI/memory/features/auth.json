{
  "feature": "authentication_authorization",
  "status": "active",
  "last_updated": "2025-10-13",
  "description": "Discord OAuth2 authentication with GG server membership verification",
  
  "architecture": {
    "frontend_auth": "NextAuth.js with Discord provider",
    "backend_verification": "Server-side admin and membership checks",
    "session_management": "JWT tokens with auto-refresh",
    "membership_cache": "5 minutes to reduce Discord API calls"
  },
  
  "authentication_flow": {
    "1_oauth_initiation": {
      "trigger": "User clicks 'Sign in with Discord'",
      "provider": "Discord OAuth2",
      "scopes": ["identify", "guilds"],
      "implementation": "frontend/pages/api/auth/[...nextauth].ts"
    },
    "2_token_exchange": {
      "process": "Discord returns access token and refresh token",
      "storage": "Stored in JWT token (NextAuth session)",
      "fields_captured": [
        "access_token",
        "refresh_token",
        "expires_at",
        "discord_id",
        "username",
        "discriminator",
        "avatar"
      ]
    },
    "3_membership_verification": {
      "endpoint": "frontend/pages/api/verify-gg-member.ts",
      "process": [
        "1. Get access token from NextAuth session",
        "2. Call Discord API: GET /users/@me/guilds",
        "3. Check if GG_GUILD_ID in user's guilds",
        "4. Cache result for 5 minutes",
        "5. Return isGGMember boolean"
      ],
      "timeout": "8 seconds",
      "retry": "Exponential backoff (max 5 attempts)"
    },
    "4_session_creation": {
      "process": "NextAuth creates session with user data",
      "available_to_client": [
        "user.discordId",
        "user.username",
        "user.avatar",
        "accessToken"
      ],
      "implementation": "frontend/lib/auth.tsx:AuthProvider"
    }
  },
  
  "authorization_patterns": {
    "api_calls": {
      "all_requests": "Must include user_id (Discord ID) from session",
      "admin_requests": "Must include is_admin=true parameter",
      "server_verification": "Backend ALWAYS verifies admin status",
      "never_trust_client": "Admin status checked server-side, not from client"
    },
    
    "admin_verification": {
      "super_admins": {
        "storage": "Environment variable SUPER_ADMIN_IDS",
        "format": "Comma-separated Discord IDs",
        "privileges": "Can add/remove other admins"
      },
      "regular_admins": {
        "storage": "admins table in database",
        "added_by": "Super admin Discord ID tracked",
        "is_active": "Boolean flag for deactivation"
      },
      "check_function": "backend/routes/admin.py:is_super_admin()"
    }
  },
  
  "error_handling": {
    "timeout": {
      "code": "ECONNABORTED",
      "message": "Request timed out. Discord API might be slow. Try again.",
      "action": "Auto-retry with exponential backoff"
    },
    "rate_limit": {
      "status": 429,
      "discord_header": "Retry-After (seconds)",
      "message": "Rate limited by Discord. Wait X seconds.",
      "action": "Show wait time to user, auto-retry after"
    },
    "token_expired": {
      "status": 401,
      "message": "Authentication expired. Sign out and sign back in.",
      "action": "Attempt token refresh, or force sign out"
    },
    "not_gg_member": {
      "condition": "isGGMember = false",
      "message": "You must be a member of the GG Discord server.",
      "action": "Show join instructions, block access"
    }
  },
  
  "caching_strategy": {
    "membership_check": {
      "duration": "5 minutes",
      "key": "gg_member_status_{discord_id}",
      "invalidation": "Time-based (no manual invalidation)",
      "rationale": "Reduces Discord API calls by ~80%"
    },
    "session_data": {
      "duration": "Until token expires (typically 1 hour)",
      "refresh": "Auto-refresh if refresh_token valid",
      "storage": "Client-side NextAuth session cookie"
    }
  },
  
  "token_refresh": {
    "trigger": "When access_token expires",
    "process": [
      "1. Check if refresh_token exists and valid",
      "2. Call Discord OAuth token refresh endpoint",
      "3. Update access_token and refresh_token",
      "4. Update expires_at timestamp",
      "5. Continue request with new token"
    ],
    "failure_handling": "If refresh fails, clear tokens and force sign out",
    "implementation": "frontend/pages/api/auth/[...nextauth].ts:jwt callback"
  },
  
  "api_endpoints": {
    "auth_endpoints": {
      "signin": "GET /api/auth/signin - NextAuth sign in page",
      "callback": "GET /api/auth/callback/discord - OAuth callback",
      "signout": "POST /api/auth/signout - Clear session",
      "session": "GET /api/auth/session - Get current session"
    },
    "verification": {
      "verify_member": "GET /api/verify-gg-member - Check GG membership",
      "response": {
        "isGGMember": "boolean",
        "discordId": "string",
        "username": "string",
        "debug": "object (includes guild list)"
      }
    }
  },
  
  "frontend_components": {
    "AuthProvider": {
      "location": "frontend/lib/auth.tsx",
      "provides": {
        "isAuthenticated": "boolean",
        "isGGMember": "boolean",
        "isAdmin": "boolean",
        "user": "object",
        "loading": "boolean",
        "error": "string | null",
        "retryCount": "number"
      },
      "methods": ["checkGGMembership()", "signOut()"]
    },
    
    "GGMemberGuard": {
      "location": "frontend/components/GGMemberGuard.tsx",
      "purpose": "Protect routes requiring GG membership",
      "states": [
        "loading → Show spinner",
        "not_authenticated → Show sign in prompt",
        "not_gg_member → Show membership required",
        "is_gg_member → Render children"
      ]
    },
    
    "DiscordAuth": {
      "location": "frontend/components/DiscordAuth.tsx",
      "purpose": "Sign in/out button",
      "features": ["User avatar display", "Loading state", "Sign out"]
    }
  },
  
  "backend_verification": {
    "user_id_required": {
      "pattern": "user_id: str = Query(..., description='Discord ID')",
      "usage": "All endpoints that need user context",
      "source": "session.user.discordId from frontend"
    },
    
    "admin_required": {
      "pattern": [
        "user_id: str = Query(...)",
        "is_admin: bool = Query(...)",
        "if not is_admin or not is_super_admin(user_id):",
        "    raise HTTPException(403)"
      ],
      "usage": "All admin-only endpoints",
      "verification": "Server-side check, never trust client"
    }
  },
  
  "security_considerations": {
    "token_storage": "Stored in HTTPOnly cookies (NextAuth default)",
    "csrf_protection": "NextAuth built-in CSRF tokens",
    "token_encryption": "NextAuth encrypts session data",
    "api_key_exposure": "Never expose Discord client secret to frontend",
    "admin_spoofing": "Always verify admin status server-side",
    "session_hijacking": "Tokens tied to user agent and IP (NextAuth)"
  },
  
  "environment_variables": {
    "frontend": {
      "DISCORD_CLIENT_ID": "Discord OAuth app client ID",
      "DISCORD_CLIENT_SECRET": "Discord OAuth app secret",
      "NEXTAUTH_SECRET": "Random secret for NextAuth encryption",
      "NEXTAUTH_URL": "Base URL (http://localhost:3000 dev)",
      "NEXT_PUBLIC_GG_GUILD_ID": "GG Discord server ID",
      "NEXT_PUBLIC_ADMIN_IDS": "Comma-separated admin Discord IDs"
    },
    "backend": {
      "SUPER_ADMIN_IDS": "Comma-separated super admin Discord IDs"
    }
  },
  
  "common_operations": {
    "user_signin": {
      "steps": [
        "1. User clicks 'Sign in with Discord'",
        "2. Redirected to Discord OAuth",
        "3. User authorizes app (identify, guilds scopes)",
        "4. Discord redirects back with code",
        "5. NextAuth exchanges code for tokens",
        "6. Creates session with user data",
        "7. Frontend checks GG membership",
        "8. If member: Allow access",
        "9. If not member: Show error"
      ],
      "files": [
        "frontend/components/DiscordAuth.tsx",
        "frontend/pages/api/auth/[...nextauth].ts",
        "frontend/pages/api/verify-gg-member.ts",
        "frontend/lib/auth.tsx"
      ]
    },
    
    "admin_action": {
      "steps": [
        "1. Admin performs action in UI",
        "2. Frontend sends request with user_id and is_admin=true",
        "3. Backend receives request",
        "4. Verifies is_admin parameter is true",
        "5. Calls is_super_admin(user_id) to verify",
        "6. If not admin: raise HTTPException(403)",
        "7. If admin: Proceed with action",
        "8. Log admin action for audit"
      ],
      "files": [
        "backend/routes/admin.py",
        "backend/routes/scripts.py (admin endpoints)"
      ]
    }
  },
  
  "known_gotchas": [
    "GG membership cached for 5 minutes (may show stale status briefly)",
    "Discord rate limits can cause auth delays (mitigated with retry)",
    "Token refresh happens automatically (transparent to user)",
    "Admin status MUST be verified server-side (never trust client)",
    "User can be authenticated but not GG member (block access)",
    "Session expires after 1 hour (auto-refresh if refresh_token valid)",
    "Environment vars must match between Discord app and config"
  ],
  
  "testing_checklist": [
    "User can sign in with Discord",
    "GG member can access protected routes",
    "Non-GG member blocked with message",
    "Admin status verified server-side",
    "Rate limit retry works",
    "Token refresh works on expiry",
    "Sign out clears session",
    "Membership cache works (no repeated API calls)",
    "Error messages user-friendly",
    "Session persists on page refresh"
  ]
}

